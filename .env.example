RECAPTCHA_SECRET_KEY=

# Background Removal API Configuration
# Configure your background removal service (e.g., remove.bg, Cloudinary, etc.)
BG_REMOVAL_API_KEY=
BG_REMOVAL_API_URL=https://api.remove.bg/v1.0/removebg
